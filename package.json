{
  "name": "agent-progress-studio",
  "version": "0.3.0-desktop.1",
  "description": "Private local AI task monitoring for Windows. Desktop Edition.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "start": "electron .",
    "demo": "electron . --aps-demo",
    "test": "node --test tests/*.test.mjs",
    "verify": "node scripts/verify.mjs",
    "test:browser": "node tests/browser.mjs && node tests/browser-privacy.mjs",
    "version:sync": "node scripts/version.mjs --write",
    "version:check": "node scripts/version.mjs",
    "web:start": "node src/server.mjs",
    "web:demo": "node src/server.mjs --demo",
    "desktop:build": "electron-builder --win nsis --x64 --publish never",
    "desktop:unpacked": "electron-builder --win --x64 --dir --publish never",
    "test:desktop": "node tests/desktop-window.mjs && node tests/floating-window.mjs && node tests/edge-window.mjs && node tests/pet-window.mjs && node tests/pet-experience.mjs",
    "pet:compile": "node scripts/compile-pet-art.mjs"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "playwright": "1.56.1"
  },
  "productName": "Agent Progress Studio",
  "main": "desktop/main.cjs",
  "author": "Agent Progress Studio contributors",
  "build": {
    "appId": "com.agentprogressstudio.desktop",
    "productName": "Agent Progress Studio",
    "executableName": "AgentProgressStudio",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "dist",
      "buildResources": "desktop/assets"
    },
    "files": [
      "package.json",
      "desktop/**/*.cjs",
      "desktop/**/*.mjs",
      "desktop/assets/icon.png",
      "desktop/assets/icon.ico",
      "desktop/licenses/*",
      "public/**/*",
      "src/**/*.mjs",
      "src/adapters/contract.d.ts",
      "experiments/work-hooks/plugin/hooks/record-event.js",
      "experiments/work-hooks/plugin/package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "!**/settings.json",
      "!**/node_modules/**/*",
      "!**/.aps-data/**/*",
      "!**/*.log"
    ],
    "afterPack": "desktop/fuses.cjs",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "desktop/assets/icon.ico",
      "artifactName": "AgentProgressStudio-${version}-Setup.${ext}"
    },
    "nsis": {
      "include": "desktop/installer.nsh",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Agent Progress Studio",
      "uninstallDisplayName": "Agent Progress Studio Desktop",
      "installerIcon": "desktop/assets/icon.ico",
      "uninstallerIcon": "desktop/assets/icon.ico"
    },
    "publish": null,
    "buildVersion": "0.3.0.1",
    "buildNumber": "1"
  }
}
